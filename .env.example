# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=coin_flip_bot
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/coin_flip_bot

# EVM Configuration
# This wallet receives all player deposits and sends all payouts
EVM_RPC_URL=https://public-mainnet.rpcpaxeer.online/app
EVM_GAS_LIMIT=13000000
EVM_PRIVATE_KEY=your_private_key_here
# EVM dev wallet - receives 10% fees (5% dev + 5% burn) from each flip
EVM_DEV_WALLET=0x9d86eA263edF94507a56C4e7960edC17b002A954
EVM_DEV_PRIVATE_KEY=  # Optional: private key for EVM dev/fee wallet — enables distributing directly from it

# Solana Configuration
# This wallet receives all player deposits and sends all payouts
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your_private_key_here
# Solana dev wallet - receives 10% fees (5% dev + 5% burn) from each flip
SOL_DEV_WALLET=Dq3XmkQ8hYJcRvT7mjtmrzBKgzFzmZwLvwerr3exTESA
SOL_DEV_PRIVATE_KEY=  # Optional: private key for Solana dev/fee wallet — enables distributing directly from it

# Bot Configuration
FLIP_TIMEOUT_SECONDS=180
MAX_CONCURRENT_FLIPS_PER_GROUP=1
# Minimum native balance (display units) to always keep in the bot wallet for gas fees.
# The dev fee and burn fee sends are capped so this reserve is never consumed.
BOT_GAS_RESERVE=0.1
NETWORK=mainnet

# Admin User IDs (comma-separated for multiple admins)
# Only these users can use admin commands
ADMIN_IDS=your_telegram_user_id_here

# Coin Flip Randomness Service (Python microservice)
# URL of the flip-service (e.g. http://localhost:8080 or your deployed service URL)
# If unset, the bot falls back to local crypto.randomInt (still CSPRNG-backed)
FLIP_SERVICE_URL=http://localhost:8080
# Shared secret between the bot and the flip service — must match FLIP_SERVICE_API_KEY in the service
FLIP_SERVICE_API_KEY=change_me_to_a_long_random_secret

# Supported Tokens (comma-separated)
# Format: NETWORK:TOKEN_ADDRESS:DECIMALS:SYMBOL
# Use "NATIVE" for native tokens (e.g., PAX on Paxeer)
# Example: EVM:NATIVE:18:PAX,EVM:0x86949e4cdb89496490890b67c9cff63ed8efb4b1:6:SID,EVM:0x2aA5968F710080ea453e7e09E59d769E8C470fac:6:FLIP
SUPPORTED_TOKENS=EVM:NATIVE:18:PAX,EVM:0x86949e4cdb89496490890b67c9cff63ed8efb4b1:6:SID,EVM:0x2aA5968F710080ea453e7e09E59d769E8C470fac:6:FLIP,EVM:0x8867187F55b976670EC14599270a95da01CC0B89:6:PAXIE

# $FLIP Profit Share Distribution
# Contract address of the $FLIP token on Paxeer — holders receive 5% of every EVM flip
FLIP_TOKEN_ADDRESS=0x2aA5968F710080ea453e7e09E59d769E8C470fac
# Paxscan API base URL — used for tokenholderlist queries during profit share distribution
# Must point to the public explorer (paxscan.io), NOT paxscan.paxeer.app (which doesn't support tokenholderlist)
PAXSCAN_API_URL=https://paxscan.io/api
# Set to true to skip the startup catchup run (useful when restarting mid-day to deploy fixes)
# PROFIT_SHARE_SKIP_CATCHUP=true
# Sidiora.fun AMM pool address — excluded from supply denominator and from receiving distributions
SIDIORA_EXCHANGE_ADDRESS=0xA0Cd0F92f12f881aeBaFF9e0fb3144511c9ebF6c
# Optional: comma-separated list of any additional addresses to exclude
# FLIP_EXCLUDED_ADDRESSES=0xAbc...,0xDef...

# Logging
LOG_LEVEL=info
